generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  roles        String[] @default(["user"])
  tokenVersion Int      @default(0)
}

model Setting {
  id          String  @id @default(uuid())
  key         String  @unique
  value       String
  description String?
}
