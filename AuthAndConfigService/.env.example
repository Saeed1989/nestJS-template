DATABASE_URL=postgresql://user:password@localhost:5432/auth_config_db
# Admin connection used only by scripts/setup-db.ts to create the role/database.
# Must be a superuser (or have CREATEROLE + CREATEDB). Never used by the app.
POSTGRES_ADMIN_URL=postgresql://postgres:postgres@localhost:5432/postgres
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
PORT=3001
